    function seedMembership(id, d) { return (!osaiSeed(id) || workspace(d) == 'osai') && (!oscpSeed(id) || workspace(d) == 'oscp'); }
    function targetLink(uid,d) {
      let id = d.machineId;
      return id == null || (exists(/databases/$(database)/documents/users/$(uid)/machines/$(id))
        ? workspace(get(/databases/$(database)/documents/users/$(uid)/machines/$(id)).data) == workspace(d)
        : (workspace(d) == 'osai' ? osaiSeed(id) : oscpSeed(id)));
    }
    function validNoteData(d) {
      return d.keys().hasAll(['title','contentJson','text','tags','machineId','week','attachmentIds','schemaVersion','deletedAt','sourceHtml','revision','lastMutationId','createdAt','updatedAt']) &&
       validWorkspace(d) && d.keys().hasOnly(['workspace','title','contentJson','text','tags','machineId','week','attachmentIds','schemaVersion','deletedAt','sourceHtml','revision','lastMutationId','createdAt','updatedAt']) &&
       bounded(d.title,200) && d.contentJson is string && d.text is string && (d.sourceHtml == null || d.sourceHtml is string) &&
       d.contentJson.toUtf8().size() + d.text.toUtf8().size() + (d.sourceHtml == null ? 0 : d.sourceHtml.toUtf8().size()) <= 614400 &&
       tagList(d.tags) && imageIds(d.attachmentIds) && (d.machineId == null || pathId(d.machineId)) && weekValue(d.week) && d.schemaVersion == 1 &&
       (d.deletedAt == null || (d.deletedAt is int && d.deletedAt >= 0)) && validRevisionFields(d);
    }
    function validRevisionFields(d) { return d.revision is int && d.revision >= 1 && d.revision <= 2147483647 && pathId(d.lastMutationId) && d.createdAt is timestamp && d.updatedAt is timestamp; }
    function validMachineData(d) {
      return d.keys().hasAll(['name','platform','os','tags','legacyKey','week','progress','revision','lastMutationId','createdAt','updatedAt']) &&
       validWorkspace(d) && d.keys().hasOnly(['workspace','name','platform','os','tags','legacyKey','week','progress','revision','lastMutationId','createdAt','updatedAt']) && bounded(d.name,200) && bounded(d.platform,80) && bounded(d.os,80) &&
       tagList(d.tags) && (d.legacyKey == null || bounded(d.legacyKey,400)) && weekValue(d.week) && d.progress in ['not-started','in-progress','completed'] && validRevisionFields(d);
    }
    function creating(d) { return d.revision == 1 && d.createdAt == request.time && d.updatedAt == request.time; }
    function replacing(d) { return workspace(d) == workspace(resource.data) && d.revision == resource.data.revision + 1 && d.createdAt == resource.data.createdAt && d.updatedAt == request.time && d.lastMutationId != resource.data.lastMutationId; }
    match /users/{uid}/notebookNotes/{noteId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && pathId(noteId) && !exists(/databases/$(database)/documents/users/$(uid)/purgedNotes/$(noteId)) && validNoteData(request.resource.data) && targetLink(uid, request.resource.data) && creating(request.resource.data);
      allow update: if isOwner(uid) && validNoteData(request.resource.data) && targetLink(uid, request.resource.data) && replacing(request.resource.data) &&
        getAfter(/databases/$(database)/documents/users/$(uid)/noteHistory/$(noteId)/versions/$(string(resource.data.revision))).data == resource.data;
      allow delete: if isOwner(uid) && resource.data.deletedAt != null && existsAfter(/databases/$(database)/documents/users/$(uid)/purgedNotes/$(noteId));
    }
    match /users/{uid}/migrations/{migrationId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && pathId(migrationId) &&
        request.resource.data.keys().hasAll(['destinationId','kind','digest','createdAt']) &&
        request.resource.data.keys().hasOnly(['destinationId','kind','digest','createdAt']) &&
        pathId(request.resource.data.destinationId) && request.resource.data.digest.matches('^[a-f0-9]{64}$') && request.resource.data.createdAt == request.time &&
        ((request.resource.data.kind == 'note' &&
          !exists(/databases/$(database)/documents/users/$(uid)/notebookNotes/$(request.resource.data.destinationId)) &&
          getAfter(/databases/$(database)/documents/users/$(uid)/notebookNotes/$(request.resource.data.destinationId)).data.lastMutationId == migrationId) ||
         (request.resource.data.kind == 'machine' &&
          !exists(/databases/$(database)/documents/users/$(uid)/machines/$(request.resource.data.destinationId)) &&
          getAfter(/databases/$(database)/documents/users/$(uid)/machines/$(request.resource.data.destinationId)).data.lastMutationId == migrationId));
    }
    match /users/{uid}/purgedNotes/{noteId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['deletedAt']) && request.resource.data.deletedAt == request.time &&
        get(/databases/$(database)/documents/users/$(uid)/notebookNotes/$(noteId)).data.deletedAt != null &&
        !existsAfter(/databases/$(database)/documents/users/$(uid)/notebookNotes/$(noteId));
    }
    match /users/{uid}/machines/{machineId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && pathId(machineId) && validMachineData(request.resource.data) && seedMembership(machineId, request.resource.data) && creating(request.resource.data);
      allow update: if isOwner(uid) && validMachineData(request.resource.data) && seedMembership(machineId, request.resource.data) && replacing(request.resource.data);
    }
    match /users/{uid}/noteHistory/{noteId}/versions/{versionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
       versionId == string(request.resource.data.revision) &&
       request.resource.data == get(/databases/$(database)/documents/users/$(uid)/notebookNotes/$(noteId)).data &&
       getAfter(/databases/$(database)/documents/users/$(uid)/notebookNotes/$(noteId)).data.revision == request.resource.data.revision + 1;
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // Everything else is denied by default.
  }
}
