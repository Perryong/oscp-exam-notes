rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// All data is private to the signed-in user (Firebase Auth, email/password).
//
// Collection: users/{userId}/notes
// Document ID: "week-<n>", where <n> is the week number (1-500)
// Fields:
//   - html: string (required, max 400,000 chars) - the week's notes as sanitised HTML.
//           Screenshots are referenced by id (data-fimg), not embedded.
//   - text: string (required, max 200,000 chars) - plain text of the note, used for search
//   - week: int (required, 1-500, must match the document id)
//   - updatedAt: timestamp (required, must be the server time of the write)
//
// Collection: users/{userId}/images
// Document ID: auto-generated
// Fields:
//   - data: string (required, max 1,000,000 chars) - a base64 data URL,
//           "data:image/(webp|png|jpeg|gif);base64,..."
//   - createdAt: timestamp (required, must be the server time of the write)
// Images are write-once: they can be created, read and deleted, never updated.
//
// No parent document exists at users/{userId}; nothing else in the database
// is readable or writable.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the signed-in user owns this path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify a uid field, if a client ever sends one, is the caller's own (create)
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Verify a uid field is never changed (update)
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string type and length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators (used by both create and update)
    // ===============================================================

    function isValidNote(noteId) {
      let fields = ['html', 'text', 'week', 'updatedAt'];
      let data = request.resource.data;
      return hasRequiredFields(fields) &&
        hasOnlyAllowedFields(fields) &&
        validStringLength('html', 0, 400000) &&
        validStringLength('text', 0, 200000) &&
        data.week is int && data.week >= 1 && data.week <= 500 &&
        noteId == 'week-' + string(data.week) &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidImage() {
      let fields = ['data', 'createdAt'];
      let data = request.resource.data;
      return hasRequiredFields(fields) &&
        hasOnlyAllowedFields(fields) &&
        validStringLength('data', 30, 1000000) &&
        data.data.matches('^data:image/(webp|png|jpeg|gif);base64,[A-Za-z0-9+/=]+$') &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // A user's weekly notes: only the owner can read or write them.
    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidNote(noteId);
      allow update: if isOwner(userId) && uidNotModified() && isValidNote(noteId);
      allow delete: if isOwner(userId);
    }

    // A user's screenshots: only the owner can read, add or delete them; never edited.
    match /users/{userId}/images/{imageId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidImage();
      allow update: if false;
      allow delete: if isOwner(userId);
    }


    // Notebook v1: owner-only notes and machines with monotonic revisions.
    // Notes carry editor JSON, derived text, bounded metadata, and optional raw import source.
    // History is an immutable exact snapshot of the replaced note. Images remain legacy-compatible.
    function bounded(value, max) { return value is string && value.toUtf8().size() <= max; }
    function pathId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function weekValue(value) { return value == null || (value is int && value >= 1 && value <= 500); }
    function tagList0(v) { let n = v.size(); return (n <= 0 || v[0].toUtf8().size() <= 40) && (n <= 1 || v[1].toUtf8().size() <= 40) && (n <= 2 || v[2].toUtf8().size() <= 40) && (n <= 3 || v[3].toUtf8().size() <= 40) && (n <= 4 || v[4].toUtf8().size() <= 40) && (n <= 5 || v[5].toUtf8().size() <= 40) && (n <= 6 || v[6].toUtf8().size() <= 40) && (n <= 7 || v[7].toUtf8().size() <= 40) && (n <= 8 || v[8].toUtf8().size() <= 40) && (n <= 9 || v[9].toUtf8().size() <= 40); }
    function tagList10(v) { let n = v.size(); return (n <= 10 || v[10].toUtf8().size() <= 40) && (n <= 11 || v[11].toUtf8().size() <= 40) && (n <= 12 || v[12].toUtf8().size() <= 40) && (n <= 13 || v[13].toUtf8().size() <= 40) && (n <= 14 || v[14].toUtf8().size() <= 40) && (n <= 15 || v[15].toUtf8().size() <= 40) && (n <= 16 || v[16].toUtf8().size() <= 40) && (n <= 17 || v[17].toUtf8().size() <= 40) && (n <= 18 || v[18].toUtf8().size() <= 40) && (n <= 19 || v[19].toUtf8().size() <= 40); }
    function tagList20(v) { let n = v.size(); return (n <= 20 || v[20].toUtf8().size() <= 40) && (n <= 21 || v[21].toUtf8().size() <= 40) && (n <= 22 || v[22].toUtf8().size() <= 40) && (n <= 23 || v[23].toUtf8().size() <= 40) && (n <= 24 || v[24].toUtf8().size() <= 40) && (n <= 25 || v[25].toUtf8().size() <= 40) && (n <= 26 || v[26].toUtf8().size() <= 40) && (n <= 27 || v[27].toUtf8().size() <= 40) && (n <= 28 || v[28].toUtf8().size() <= 40) && (n <= 29 || v[29].toUtf8().size() <= 40); }
    function tagList(v) { return v is list && v.size() <= 30 && v.toSet().size() == v.size() && (v.size() == 0 || tagList0(v)) && (v.size() <= 10 || tagList10(v)) && (v.size() <= 20 || tagList20(v)); }
    function imageIds(v) {
      // Round-trip equality rejects non-strings and embedded separators.
      let joined = v.join('|');
      return v is list && v.size() <= 100 && v.toSet().size() == v.size() &&
        (v.size() == 0 || (joined.split('[|]') == v && joined.matches('^[A-Za-z0-9_-]{1,128}([|][A-Za-z0-9_-]{1,128})*$')));
    }
    // Legacy records belong to ["seed-19b66b2bd2aeacc88f751652", "seed-c773679c6d9eed96fa88dddb", "seed-1153a1dff64a0e55c04ef3aa", "seed-9da90c0771e5115da573f183", "seed-3984548948a3f65e0c5e77ed", "seed-80044ae6bfbd1332a46677f6", "seed-9696a670f03fe8de27dce60c", "seed-33ec80db7165a0faa300a8e3", "seed-b8951d1fdb6549eb735a7725", "seed-a5513943ebf6019db6f40a10", "seed-adef71bb54249b321c67a3e1", "seed-6b723b946dc6593120446583", "seed-81e17e2f7590cf87cb662e66", "seed-3289c4484983c1f6904e4ec9", "seed-562a6ea025f19f430f7c5a2b", "seed-9422dda4a1da0f7777f16e43", "seed-e82a167c19ffe02348d3e62f", "seed-f76c28b5bcf431baecffa739", "seed-a7c6118527c83675c6bcf26c", "seed-601fe6a81e44c0b18fe0fa35", "seed-3d97c22af06732d1de6d3d75", "seed-beedcd022df2cbd2497c591a", "seed-0aa99f13b64bd0943fb600b1", "seed-117111d9c2ade8b215f0929c", "seed-a9317195621278b66facf770", "seed-e114cae6624044bd867011d1", "seed-8eb3867cc47056768fd311df", "seed-d9c0fc0ab7566cfcc8edf2ee", "seed-33403fcce9c1e770f2914086", "seed-f13cadc663bfbbdfd8d21024", "seed-fb4dc63b7d56aa20686d05fb", "seed-9733e4a36b2a5aa0f60375c5", "seed-d150386ffb2ac3b9a1f00835", "seed-6e3d8f489ef2653982f64587", "seed-5b09b06d22d533921733e26d", "seed-f3ebfd8f1c2a1c6c1d86ec28", "seed-c6278f5db10c7316b40e5a2f", "seed-97186ad87747fa8d1191e635", "seed-20ae44274d2fd7517381df2c", "seed-54ce5335c0a8dc4ae7b89d00", "seed-d8858b97227a22648df18c07", "seed-616d1814bcbee6ee1ad82663", "seed-279ecaf132d6ced9131ab741", "seed-0bf4de5acec5bd943ab6f728", "seed-381662e9af7b3dd200ecf4ea", "seed-62fe8e353182cd0d4ca07fd6", "seed-d73adcb8ac6c6764d0e51458", "seed-6fddadde4468c7bcd05590a1", "seed-24b8cadb0a1396c0c6e2cbdc", "seed-2153863c107e7d038fc85e22", "seed-a8fb37c01d2e8dd56d515fe2", "seed-a4164e1d6155dfbfba170e9e", "seed-1391257c90c5433d4088744c", "seed-2c5850518438042b03840ced", "seed-ae147de9b4aee58c31391c67", "seed-f59d69a6c7a7b5de48420da7", "seed-b980fa8c8dcf9a9f7fc4f4cd", "seed-c105b2b50b94d2e1e0fa9be6", "seed-b130b907488d2e0bba54c82d", "seed-b22bb2d5481b1f