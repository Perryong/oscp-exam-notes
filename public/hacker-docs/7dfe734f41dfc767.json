{"html":"<h2 id=\"insert-statement\">INSERT Statement</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">INSERT INTO &lt;table_name&gt; VALUES (&lt;col1_value&gt;, &lt;col2_value&gt;, &lt;col3_value&gt;, ...);\n</code></pre></div>\n<hr>\n<h2 id=\"select-statement\">SELECT Statement</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">SELECT * FROM &lt;table_name&gt;;\n</code></pre></div>\n<hr>\n<h2 id=\"drop-statement\">DROP Statement</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">DROP TABLE &lt;table_name&gt;;\n</code></pre></div>\n<hr>\n<h2 id=\"alter-statement\">ALTER Statement</h2>\n<h4 id=\"adding-a-column\">Adding a Column</h4>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">ALTER TABLE &lt;table_name&gt; ADD &lt;New_Column_name&gt; &lt;datatype&gt;;\n</code></pre></div>\n<h4 id=\"dropping-a-column\">Dropping a Column</h4>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">ALTER TABLE &lt;table_name&gt; DROP &lt;Column_name&gt;;\n</code></pre></div>\n<h4 id=\"modifying-a-column\">Modifying a Column</h4>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">ALTER TABLE &lt;table_name&gt; MODIFY &lt;Column_name&gt; &lt;new_dataype&gt;;\n</code></pre></div>\n<h4 id=\"rename-a-column\">Rename a Column</h4>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">ALTER TABLE &lt;table_name&gt; RENAME COLUMN &lt;old_Column_name&gt; TO &lt;New_Column_name&gt;;\n</code></pre></div>\n<hr>\n<h2 id=\"update-statement\">UPDATE Statement</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">UPDATE &lt;table_name&gt; SET &lt;col1&gt;=&lt;newvalue1&gt;, &lt;col2&gt;=&lt;newvalue2&gt;, ... WHERE &lt;condition&gt;;\n</code></pre></div>\n<hr>\n","toc":[{"id":"insert-statement","title":"INSERT Statement","level":2},{"id":"select-statement","title":"SELECT Statement","level":2},{"id":"drop-statement","title":"DROP Statement","level":2},{"id":"alter-statement","title":"ALTER Statement","level":2},{"id":"adding-a-column","title":"Adding a Column","level":4},{"id":"dropping-a-column","title":"Dropping a Column","level":4},{"id":"modifying-a-column","title":"Modifying a Column","level":4},{"id":"rename-a-column","title":"Rename a Column","level":4},{"id":"update-statement","title":"UPDATE Statement","level":2}]}