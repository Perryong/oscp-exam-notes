{"html":"<h2 id=\"and-operator\">AND Operator</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">SELECT * FROM &lt;table_name&gt; WHERE &lt;col1_name&gt;=&lt;something&gt; AND &lt;col2_name&gt;=&lt;something&gt;;\n</code></pre></div>\n<h2 id=\"or-operator\">OR Operator</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">SELECT * FROM &lt;table_name&gt; WHERE &lt;col1_name&gt;=&lt;something&gt; OR &lt;col2_name&gt;=&lt;somethimg&gt;;\n</code></pre></div>\n<h2 id=\"not-operator\">NOT Operator</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-mysql\">SELECT * FROM &lt;table_name&gt; WHERE &lt;col1_name&gt; NOT &lt;something&gt;;\n</code></pre></div>\n<hr>\n<h2 id=\"symbol-operators\">Symbol Operators</h2>\n<ul>\n<li><strong>AND</strong> operator can also be represented as <code>&amp;&amp;</code>.</li>\n<li><strong>OR</strong> operator can also be represented as <code>||</code>.</li>\n<li><strong>NOT</strong> operator can also be represented as <code>!</code>.</li>\n</ul>\n","toc":[{"id":"and-operator","title":"AND Operator","level":2},{"id":"or-operator","title":"OR Operator","level":2},{"id":"not-operator","title":"NOT Operator","level":2},{"id":"symbol-operators","title":"Symbol Operators","level":2}]}