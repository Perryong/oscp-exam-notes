{"html":"<h2 id=\"get-response-only\">Get Response ONLY</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">curl -I http://&lt;domain_name&gt;\n</code></pre></div>\n<hr>\n<h2 id=\"change-user-agent\">Change User-Agent</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">curl http://&lt;domain_name&gt; -A '&lt;user_agent_name'\n</code></pre></div>\n","toc":[{"id":"get-response-only","title":"Get Response ONLY","level":2},{"id":"change-user-agent","title":"Change User-Agent","level":2}]}