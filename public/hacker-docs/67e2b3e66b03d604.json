{"html":"<h2 id=\"send-get-request\">Send GET request</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">curl &lt;URL&gt;\n</code></pre></div>\n<hr>\n<h2 id=\"download-file\">Download file</h2>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">curl &lt;URL&gt;/&lt;filename&gt;\n</code></pre></div>\n","toc":[{"id":"send-get-request","title":"Send GET request","level":2},{"id":"download-file","title":"Download file","level":2}]}