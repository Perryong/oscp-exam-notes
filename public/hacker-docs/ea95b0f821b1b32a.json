{"html":"<h2 id=\"winrm-exploitation\">WinRM Exploitation</h2>\n<h3 id=\"bruteforce-attack-winrm\">Bruteforce Attack WinRM</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">netexec winrm &lt;TARGET IP&gt; -u &lt;username/user wordlist&gt; -p &lt;password/password wordlist&gt;\n</code></pre></div>\n<h3 id=\"login-winrm\">Login WinRM</h3>\n<div class=\"walkthrough-command\"><button type=\"button\" class=\"copy-command\">Copy code</button><pre><code class=\"language-bash\">evil-winrm -i &lt;TARGET IP&gt; -u &lt;username&gt; -p &lt;password&gt;\n</code></pre></div>\n","toc":[{"id":"winrm-exploitation","title":"WinRM Exploitation","level":2},{"id":"bruteforce-attack-winrm","title":"Bruteforce Attack WinRM","level":3},{"id":"login-winrm","title":"Login WinRM","level":3}]}