{
  "name": "oscp-notebook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run && npm run test:osai-vault",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:rules": "node --test tests/rules.test.mjs tests/notebook-rules.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format:check": "prettier --check src e2e scripts/*.mjs *.ts package.json vercel.json",
    "test:emulators": "firebase emulators:exec --project demo-oscp-notebook --only auth,firestore \"npm run test:rules && npm run test:integration && VITE_FIREBASE_MODE=emulator npm run test:e2e\"",
    "test:release": "playwright test --config playwright.offline.config.ts",
    "import:walkthroughs": "node scripts/import-walkthroughs.mjs",
    "import:osai-vault": "node scripts/import-osai-vault.mjs",
    "test:osai-vault": "node --test scripts/import-osai-vault.test.mjs"
  },
  "dependencies": {
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "fflate": "^0.8.3",
    "firebase": "^13.0.0",
    "idb": "^8.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.33.0",
    "jsdom": "^30.1.2",
    "marked": "^13.0.3",
    "prettier": "3.9.10",
    "sanitize-html": "^2.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
